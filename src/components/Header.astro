---
import { PRIMARY_NAV } from '../site.config';
const { pathname } = Astro.url;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand">
      <svg class="site-header__mark" width="30" height="30" viewBox="0 0 64 64" aria-hidden="true">
        <defs>
          <linearGradient id="headerMark" x1="4" y1="4" x2="60" y2="60" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#1F4E5C"/>
            <stop offset="1" stop-color="#2E7D6B"/>
          </linearGradient>
        </defs>
        <rect width="64" height="64" rx="16" fill="url(#headerMark)"/>
        <text x="32" y="43" font-family="Arial, sans-serif" font-size="27" font-weight="800" fill="#FFFFFF" text-anchor="middle" letter-spacing="-1">SM</text>
      </svg>
      <span class="site-header__brand-text">SM Global <span>Accounting Services</span></span>
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {PRIMARY_NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn--primary site-header__cta" href="/contact">Book a Free Consultation</a>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(8px);
    -webkit-backdrop-filter: saturate(180%) blur(8px);
    box-shadow: 0 1px 0 rgba(22, 35, 43, 0.03), 0 8px 24px -16px rgba(22, 35, 43, 0.12);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-top: var(--space-2);
    padding-bottom: var(--space-2);
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--color-primary);
    white-space: nowrap;
  }
  .site-header__mark {
    flex-shrink: 0;
    border-radius: 8px;
  }
  .site-header__brand-text span {
    font-weight: 500;
    color: var(--color-text-muted);
  }
  .site-header__nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
  }
  .site-header__nav a {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-text);
  }
  .site-header__nav a {
    position: relative;
    padding-bottom: 3px;
  }
  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 2px;
    background: var(--color-secondary);
    border-radius: 2px;
    transition: right 0.18s ease;
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--color-primary);
    text-decoration: none;
  }
  .site-header__nav a:hover::after,
  .site-header__nav a[aria-current='page']::after {
    right: 0;
  }
  .site-header__cta {
    white-space: nowrap;
    padding: 0.6rem 1.1rem;
    font-size: 0.9rem;
  }
  @media (max-width: 900px) {
    .site-header__inner { flex-wrap: wrap; }
    .site-header__nav ul { gap: var(--space-2); }
  }
</style>
