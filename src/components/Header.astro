---
import { PRIMARY_NAV, SITE } from '../site.config';
import Logo from './Logo.astro';
const { pathname } = Astro.url;
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="site-header__brand" aria-label="SM Global Accounting Services, home">
      <Logo class="site-header__mark" height={46} />
      <span class="site-header__brand-text">Global <span>Accounting Services</span></span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {PRIMARY_NAV.map((item) => (
          <li>
            <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="btn btn--primary site-header__cta" href={SITE.bookingUrl}>Book a Free Consultation</a>

    <details class="site-header__mobile">
      <summary class="site-header__mobile-toggle" aria-label="Open menu">
        <span></span><span></span><span></span>
      </summary>
      <div class="site-header__mobile-panel">
        <ul>
          {PRIMARY_NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={pathname === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
        <a class="btn btn--primary" href={SITE.bookingUrl}>Book a Free Consultation</a>
      </div>
    </details>
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(180%) blur(8px);
    -webkit-backdrop-filter: saturate(180%) blur(8px);
    box-shadow: 0 1px 0 rgba(30, 30, 30, 0.03), 0 8px 24px -16px rgba(30, 30, 30, 0.12);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: 0.6rem;
    padding-bottom: 0.6rem;
  }
  .site-header__brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--color-primary);
    white-space: nowrap;
    flex-shrink: 0;
  }
  /* The logo is a child component's <svg>, so Astro's scoped-style attribute
     isn't on it — :global() targets it explicitly. */
  :global(.site-header__mark) {
    flex-shrink: 0;
    display: block;
  }
  .site-header__brand-text { line-height: 1.15; }
  .site-header__brand-text span {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  /* Desktop nav: a single, non-wrapping row centred between the logo and
     the CTA button. Below the breakpoint this whole block is hidden in
     favour of the hamburger menu, rather than letting it wrap. */
  .site-header__nav {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
  }
  .site-header__nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 1.8rem;
    margin: 0;
    padding: 0;
    white-space: nowrap;
  }
  .site-header__nav a {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1rem;
    color: var(--color-text);
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: 6px;
    height: 2px;
    background: var(--color-secondary);
    border-radius: 2px;
    transition: right 0.18s ease;
  }
  .site-header__nav a:hover,
  .site-header__nav a[aria-current='page'] {
    color: var(--color-primary);
    text-decoration: none;
  }
  .site-header__nav a:hover::after,
  .site-header__nav a[aria-current='page']::after {
    right: 0;
  }

  .site-header__cta {
    white-space: nowrap;
    padding: 0.6rem 1.1rem;
    font-size: 1rem;
    min-height: 44px;
    flex-shrink: 0;
  }

  /* Between 1200px and the full container width the row is tighter, so the
     links sit closer together; below 1200px the hamburger takes over. */
  @media (max-width: 1340px) {
    .site-header__nav ul { gap: 1.2rem; }
    .site-header__inner { gap: var(--space-2); }
    .site-header__cta { padding: 0.6rem 0.9rem; }
  }

  /* Mobile hamburger menu — hidden entirely on desktop widths. */
  .site-header__mobile { display: none; }

  /* The switch to the hamburger menu happens at 1199px, before the six links
     and the button run out of room. If you add a link, re-test at 1200px. */
  @media (max-width: 480px) {
    .site-header__brand-text { font-size: 1rem; white-space: normal; max-width: 11rem; }
  }

  @media (max-width: 1199px) {
    .site-header__nav,
    .site-header__cta {
      display: none;
    }
    .site-header__inner {
      justify-content: space-between;
    }

    .site-header__mobile {
      display: block;
      position: relative;
    }
    .site-header__mobile-toggle {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      cursor: pointer;
      list-style: none;
      border-radius: 8px;
    }
    .site-header__mobile-toggle::-webkit-details-marker { display: none; }
    .site-header__mobile-toggle span {
      display: block;
      width: 22px;
      height: 2px;
      margin: 0 auto;
      background: var(--color-primary);
      border-radius: 2px;
      transition: transform 0.18s ease, opacity 0.18s ease;
    }
    .site-header__mobile[open] .site-header__mobile-toggle span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .site-header__mobile[open] .site-header__mobile-toggle span:nth-child(2) {
      opacity: 0;
    }
    .site-header__mobile[open] .site-header__mobile-toggle span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .site-header__mobile-panel {
      position: absolute;
      top: calc(100% + 0.9rem);
      right: 0;
      width: min(320px, calc(100vw - 2.5rem));
      background: #fff;
      border: 1px solid var(--color-border);
      border-radius: var(--radius);
      box-shadow: 0 20px 40px -18px rgba(30, 30, 30, 0.32);
      padding: var(--space-2);
      z-index: 60;
    }
    .site-header__mobile-panel ul {
      list-style: none;
      margin: 0 0 var(--space-2);
      padding: 0;
    }
    .site-header__mobile-panel li + li {
      border-top: 1px solid var(--color-border);
    }
    .site-header__mobile-panel a {
      display: block;
      padding: 0.8rem 0.4rem;
      min-height: 48px;
      font-size: 1.05rem;
      font-family: var(--font-heading);
      font-weight: 600;
      color: var(--color-text);
    }
    .site-header__mobile-panel a:hover,
    .site-header__mobile-panel a[aria-current='page'] {
      color: var(--color-primary);
      text-decoration: none;
    }
    .site-header__mobile-panel .btn {
      display: block;
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  // @ts-nocheck — plain progressive-enhancement DOM script, not type-checked.
  // Every menu above already opens, closes and is keyboard-reachable using
  // nothing but native <details>/<summary>. This just adds the extra polish
  // of closing a panel when someone clicks outside it, presses Escape, or
  // picks a link — all optional, so if this script fails to run for any
  // reason the menus still work perfectly.
  const openPanels = () => document.querySelectorAll('header details[open]');

  document.addEventListener('click', (event) => {
    for (const panel of openPanels()) {
      if (!panel.contains(event.target)) panel.open = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      for (const panel of openPanels()) panel.open = false;
    }
  });

  document.querySelectorAll('header details a').forEach((link) => {
    link.addEventListener('click', () => {
      link.closest('details')?.removeAttribute('open');
    });
  });
</script>
