---
import { FOOTER_NAV, LEGAL_NAV, SITE } from '../site.config';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__brand">
        <svg class="site-footer__mark" width="26" height="26" viewBox="0 0 64 64" aria-hidden="true">
          <defs>
            <linearGradient id="footerMark" x1="4" y1="4" x2="60" y2="60" gradientUnits="userSpaceOnUse">
              <stop offset="0" stop-color="#3a8f9c"/>
              <stop offset="1" stop-color="#4fae94"/>
            </linearGradient>
          </defs>
          <rect width="64" height="64" rx="16" fill="url(#footerMark)"/>
          <text x="32" y="43" font-family="Arial, sans-serif" font-size="27" font-weight="800" fill="#FFFFFF" text-anchor="middle" letter-spacing="-1">SM</text>
        </svg>
        <span>SM Global Accounting Services</span>
      </p>
      <p class="site-footer__tagline">Outsourced bookkeeping, statutory accounts and tax support for UK accountancy practices.</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {FOOTER_NAV.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-footer__contact">
      <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <p>{SITE.phone}</p>
      <p>{SITE.address}</p>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <p>&copy; {year} SM Global Accounting Services. All rights reserved.</p>
    <nav aria-label="Legal" class="site-footer__legal">
      <ul>
        {LEGAL_NAV.map((item, i) => (
          <>
            <li><a href={item.href}>{item.label}</a></li>
            {i < LEGAL_NAV.length - 1 && <li aria-hidden="true" class="site-footer__legal-sep">·</li>}
          </>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-dark);
    color: #cfe1de;
    margin-top: var(--space-5);
    border-top: 3px solid transparent;
    border-image: linear-gradient(90deg, var(--color-secondary), var(--color-primary) 60%) 1;
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
    padding: var(--space-4) var(--space-3);
  }
  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.3rem;
  }
  .site-footer__mark {
    flex-shrink: 0;
    border-radius: 7px;
  }
  .site-footer__tagline { color: #a9c4bf; margin-bottom: 0; }
  .site-footer nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-footer nav a { color: #cfe1de; }
  .site-footer nav a:hover { color: #fff; }
  .site-footer__contact p { margin: 0 0 0.4rem; color: #cfe1de; }
  .site-footer__contact a { color: #cfe1de; }
  .site-footer__bottom {
    border-top: 1px solid rgba(255,255,255,0.12);
    padding: var(--space-2) var(--space-3);
    font-size: 0.85rem;
    color: #8fada7;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .site-footer__bottom p { margin: 0; }
  .site-footer__legal ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  .site-footer__legal a { color: #8fada7; }
  .site-footer__legal a:hover { color: #fff; }
  .site-footer__legal-sep { color: #5f7d78; }
</style>
