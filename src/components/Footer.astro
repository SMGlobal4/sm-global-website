---
import { FOOTER_NAV, LEGAL_NAV, SITE, SITE_PHONE_HREF } from '../site.config';
import Logo from './Logo.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="site-footer__brand">
        <Logo class="site-footer__mark" variant="light" height={40} />
        <span>Global Accounting Services</span>
      </p>
      <p class="site-footer__tagline">Outsourced bookkeeping, statutory accounts and tax support for UK accountancy practices.</p>
      {SITE.linkedin && (
        <p class="site-footer__social">
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" aria-label="SM Global Accounting Services on LinkedIn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.03-1.85-3.03-1.85 0-2.14 1.45-2.14 2.94v5.66H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z" />
            </svg>
          </a>
        </p>
      )}
    </div>
    <nav aria-label="Footer">
      <ul>
        {FOOTER_NAV.map((item) => (
          <li><a href={item.href}><svg class="site-footer__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="site-footer__contact">
      <p class="site-footer__line"><svg class="site-footer__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      {SITE.phone && <p class="site-footer__line"><svg class="site-footer__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" /></svg><a href={SITE_PHONE_HREF}>{SITE.phone}</a></p>}
      <p class="site-footer__line"><svg class="site-footer__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg><span>{SITE.address}</span></p>
    </div>
  </div>
  <div class="container site-footer__bottom">
    <p>&copy; {year} SM Global Accounting Services. All rights reserved.</p>
    <nav aria-label="Legal" class="site-footer__legal">
      <ul>
        {LEGAL_NAV.map((item, i) => (
          <>
            <li><a href={item.href}>{item.label}</a></li>
            {i < LEGAL_NAV.length - 1 && <li aria-hidden="true" class="site-footer__legal-sep">·</li>}
          </>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-primary-dark);
    color: #d9d6cc;
    margin-top: var(--space-5);
    border-top: 3px solid transparent;
    border-image: linear-gradient(90deg, var(--color-secondary), var(--color-primary) 60%) 1;
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-3);
    padding: var(--space-4) var(--space-3);
  }
  .site-footer__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-heading);
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.3rem;
  }
  :global(.site-footer__mark) {
    flex-shrink: 0;
    display: block;
  }
  .site-footer__tagline { color: #bdbab0; margin-bottom: 0; }
  .site-footer__social {
    margin: var(--space-2) 0 0;
  }
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.08);
    color: #d9d6cc;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .site-footer__social a:hover {
    background: var(--color-secondary);
    color: var(--color-on-gold);
  }
  .site-footer nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: var(--space-3);
  }
  .site-footer nav li { break-inside: avoid; }
  .site-footer nav a {
    color: #d9d6cc;
    display: inline-block;
    padding: 0.55rem 0;
    min-height: 44px;
  }
  .site-footer nav li { margin: 0; }
  .site-footer nav a:hover { color: #fff; }
  .site-footer__contact p { margin: 0 0 0.4rem; color: #d9d6cc; }
  .site-footer__line { display: flex; align-items: center; gap: 0.6rem; }
  .site-footer__icon { flex-shrink: 0; color: #e3bb45; }
  .site-footer__chev { flex-shrink: 0; color: #e3bb45; margin-right: 0.35rem; vertical-align: -1px; }
  .site-footer__contact a { color: #d9d6cc; display: inline-block; padding: 0.55rem 0; }
  .site-footer__bottom {
    border-top: 1px solid rgba(255,255,255,0.12);
    padding: var(--space-2) var(--space-3);
    font-size: 1rem;
    color: #b9b7ad;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }
  .site-footer__bottom p { margin: 0; }
  .site-footer__legal ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
  }
  .site-footer__legal a { color: #b9b7ad; display: inline-block; padding: 0.55rem 0.2rem; min-height: 44px; }
  .site-footer__legal a:hover { color: #fff; }
  .site-footer__legal-sep { color: #7d7b74; }
</style>
