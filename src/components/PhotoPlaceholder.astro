---
// A clearly marked stand-in for a real photo or screenshot that the business
// still has to supply. Deliberately looks unfinished (dashed outline, the
// word PLACEHOLDER) so it can't be mistaken for real content and shipped by
// accident. Every use is listed in LAUNCH_CHECKLIST.md ("Real content still
// needed"). When the real image exists, replace this component with an <img>
// that has meaningful alt text.
interface Props {
  label: string;     // what the image should be, e.g. "Team photo: Account Manager"
  note?: string;     // what to supply / size guidance
  ratio?: string;    // CSS aspect-ratio, e.g. "4 / 3"
  compact?: boolean; // smaller type for use inside cards
}
const { label, note, ratio = '4 / 3', compact = false } = Astro.props;
---
<div class={`photo-placeholder${compact ? ' photo-placeholder--compact' : ''}`} style={`aspect-ratio: ${ratio};`} role="img" aria-label={`Placeholder: ${label}`}>
  <p class="photo-placeholder__tag">Placeholder</p>
  <p class="photo-placeholder__label">{label}</p>
  {note && <p class="photo-placeholder__note">{note}</p>}
</div>

<style>
  .photo-placeholder {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.35rem;
    padding: var(--space-3);
    background: #fffaf0;
    border: 2px dashed #b88a00;
    border-radius: 14px;
    color: #5c4300;
  }
  .photo-placeholder p { margin: 0; }
  .photo-placeholder__tag {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .photo-placeholder__label {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.1rem;
    color: #3d2d00;
  }
  .photo-placeholder__note {
    font-size: 1rem;
    max-width: 34ch;
  }
  .photo-placeholder--compact { padding: var(--space-2); }
  .photo-placeholder--compact .photo-placeholder__label { font-size: 1rem; }
  .photo-placeholder--compact .photo-placeholder__note { font-size: 1rem; }
</style>
