---
// Small hand-built line-icon set — no external icon library, so the site
// stays dependency-free and fast. Add new shapes here as needed.
interface Props {
  name:
    | 'shield' | 'shield-check' | 'clock' | 'users' | 'badge-check'
    | 'document' | 'percent' | 'book' | 'building' | 'briefcase'
    | 'lock' | 'server' | 'layers' | 'bolt' | 'sliders' | 'heart';
  size?: number;
}
const { name, size = 26 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === 'shield' && (
    <path d="M12 2.5 19.5 5.5 V11 C19.5 16 16 19.8 12 21.5 C8 19.8 4.5 16 4.5 11 V5.5 Z" />
  )}
  {name === 'shield-check' && (
    <>
      <path d="M12 2.5 19.5 5.5 V11 C19.5 16 16 19.8 12 21.5 C8 19.8 4.5 16 4.5 11 V5.5 Z" />
      <path d="M8.75 12 11 14.25 15.5 9.5" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7 V12 L15.5 14" />
    </>
  )}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8.5" r="3.25" />
      <path d="M2.75 20 C2.75 15.9 5.5 13 9 13 C12.5 13 15.25 15.9 15.25 20" />
      <circle cx="17.5" cy="8.75" r="2.4" />
      <path d="M15.6 13.3 C18.6 13.6 20.6 15.9 21.1 19" />
    </>
  )}
  {name === 'badge-check' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M8 12.3 10.7 15 16 9.3" />
    </>
  )}
  {name === 'document' && (
    <>
      <path d="M6.5 2.5 H14 L18.5 7 V21.5 H6.5 Z" />
      <path d="M14 2.5 V7 H18.5" />
      <path d="M9 12.5 H16 M9 16 H16" />
    </>
  )}
  {name === 'percent' && (
    <>
      <circle cx="7.5" cy="7.5" r="2.25" />
      <circle cx="16.5" cy="16.5" r="2.25" />
      <path d="M17.5 6 6.5 18" />
    </>
  )}
  {name === 'book' && (
    <path d="M12 5.5 C9.8 4 6.7 3.5 3.5 4.5 V18.5 C6.7 17.5 9.8 18 12 19.5 C14.2 18 17.3 17.5 20.5 18.5 V4.5 C17.3 3.5 14.2 4 12 5.5 Z" />
  )}
  {name === 'building' && (
    <>
      <rect x="4" y="3" width="10.5" height="18" rx="0.5" />
      <rect x="15.5" y="9.5" width="4.5" height="11.5" rx="0.5" />
      <path d="M7 7 H11.5 M7 10.5 H11.5 M7 14 H11.5 M7 17.5 H11.5" />
    </>
  )}
  {name === 'briefcase' && (
    <>
      <rect x="3" y="8" width="18" height="12" rx="1.5" />
      <path d="M8.5 8 V6.5 C8.5 5.4 9.4 4.5 10.5 4.5 H13.5 C14.6 4.5 15.5 5.4 15.5 6.5 V8" />
      <path d="M3 13.5 H21" />
    </>
  )}
  {name === 'lock' && (
    <>
      <rect x="5" y="11" width="14" height="10" rx="1.5" />
      <path d="M8 11 V7.5 C8 5 9.8 3 12 3 C14.2 3 16 5 16 7.5 V11" />
    </>
  )}
  {name === 'server' && (
    <>
      <rect x="3" y="4" width="18" height="6.5" rx="1" />
      <rect x="3" y="13.5" width="18" height="6.5" rx="1" />
      <circle cx="7" cy="7.25" r="0.75" fill="currentColor" />
      <circle cx="7" cy="16.75" r="0.75" fill="currentColor" />
    </>
  )}
  {name === 'layers' && (
    <>
      <path d="M12 3 21 8 12 13 3 8 Z" />
      <path d="M3 13 12 18 21 13" />
    </>
  )}
  {name === 'bolt' && <path d="M13 2.5 4.5 14 H10.5 L9.5 21.5 L18.5 10 H12.5 Z" />}
  {name === 'sliders' && (
    <>
      <path d="M3.5 6 H20.5" />
      <path d="M3.5 12 H20.5" />
      <path d="M3.5 18 H20.5" />
      <circle cx="15" cy="6" r="2" fill="currentColor" />
      <circle cx="8" cy="12" r="2" fill="currentColor" />
      <circle cx="17" cy="18" r="2" fill="currentColor" />
    </>
  )}
  {name === 'heart' && (
    <path d="M12 20.5 C12 20.5 3.5 15.3 3.5 9.3 C3.5 6.2 5.9 4 8.7 4 C10.4 4 11.6 4.9 12 5.8 C12.4 4.9 13.6 4 15.3 4 C18.1 4 20.5 6.2 20.5 9.3 C20.5 15.3 12 20.5 12 20.5 Z" />
  )}
</svg>
