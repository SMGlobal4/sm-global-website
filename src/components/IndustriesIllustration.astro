---
// Original illustration for the Industries page: a hub-and-spoke diagram —
// one practice at the centre, six sector types around it — matching the six
// sector cards on the page itself and reusing their exact icons (layers,
// users, building, bolt, heart, briefcase) so the picture and the copy
// agree, same approach as SecurityIllustration.astro and
// ProcessIllustration.astro.
---
<svg
  class="hero-illustration"
  viewBox="0 0 480 420"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="ind-hub" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#666666" />
      <stop offset="1" stop-color="#2e2e2e" />
    </linearGradient>
  </defs>

  <!-- soft backdrop shapes -->
  <circle cx="240" cy="200" r="180" fill="#BF9100" opacity="0.05" />
  <circle cx="60" cy="350" r="70" fill="#595959" opacity="0.06" />

  <!-- spokes -->
  <g stroke="#d9d6cc" stroke-width="2">
    <line x1="240" y1="200" x2="240" y2="50" />
    <line x1="240" y1="200" x2="369.9" y2="125" />
    <line x1="240" y1="200" x2="369.9" y2="275" />
    <line x1="240" y1="200" x2="240" y2="350" />
    <line x1="240" y1="200" x2="110.1" y2="275" />
    <line x1="240" y1="200" x2="110.1" y2="125" />
  </g>

  <!-- central hub -->
  <circle cx="240" cy="200" r="46" fill="url(#ind-hub)" />
  <text x="240" y="207" font-family="Manrope, sans-serif" font-size="17" font-weight="700" fill="#ffffff" text-anchor="middle">SM</text>

  <!-- six sector nodes, each a static outer <g> (position) wrapping an
       inner <g> (formerly animated; drift removed). -->
  <g transform="translate(240,50)">
    <g class="hi-float hi-float--1">
      <circle r="27" fill="#ffffff" stroke="#e6e3dc" stroke-width="1.5" />
      <g transform="translate(-13,-13) scale(1.1)" stroke="#BF9100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <path d="M12 3 21 8 12 13 3 8 Z" />
        <path d="M3 13 12 18 21 13" />
      </g>
    </g>
  </g>

  <g transform="translate(369.9,125)">
    <g class="hi-float hi-float--2">
      <circle r="27" fill="#ffffff" stroke="#e6e3dc" stroke-width="1.5" />
      <g transform="translate(-13,-13) scale(1.1)" stroke="#595959" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <circle cx="9" cy="8.5" r="3.25" />
        <path d="M2.75 20 C2.75 15.9 5.5 13 9 13 C12.5 13 15.25 15.9 15.25 20" />
        <circle cx="17.5" cy="8.75" r="2.4" />
        <path d="M15.6 13.3 C18.6 13.6 20.6 15.9 21.1 19" />
      </g>
    </g>
  </g>

  <g transform="translate(369.9,275)">
    <g class="hi-float hi-float--3">
      <circle r="27" fill="#ffffff" stroke="#e6e3dc" stroke-width="1.5" />
      <g transform="translate(-13,-13) scale(1.1)" stroke="#BF9100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <rect x="4" y="3" width="10.5" height="18" rx="0.5" />
        <rect x="15.5" y="9.5" width="4.5" height="11.5" rx="0.5" />
        <path d="M7 7 H11.5 M7 10.5 H11.5 M7 14 H11.5 M7 17.5 H11.5" />
      </g>
    </g>
  </g>

  <g transform="translate(240,350)">
    <g class="hi-float hi-float--4">
      <circle r="27" fill="#ffffff" stroke="#e6e3dc" stroke-width="1.5" />
      <g transform="translate(-13,-13) scale(1.1)" stroke="#595959" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <path d="M13 2.5 4.5 14 H10.5 L9.5 21.5 L18.5 10 H12.5 Z" />
      </g>
    </g>
  </g>

  <g transform="translate(110.1,275)">
    <g class="hi-float hi-float--5">
      <circle r="27" fill="#ffffff" stroke="#e6e3dc" stroke-width="1.5" />
      <g transform="translate(-13,-13) scale(1.1)" stroke="#BF9100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <path d="M12 20.5 C12 20.5 3.5 15.3 3.5 9.3 C3.5 6.2 5.9 4 8.7 4 C10.4 4 11.6 4.9 12 5.8 C12.4 4.9 13.6 4 15.3 4 C18.1 4 20.5 6.2 20.5 9.3 C20.5 15.3 12 20.5 12 20.5 Z" />
      </g>
    </g>
  </g>

  <g transform="translate(110.1,125)">
    <g class="hi-float hi-float--6">
      <circle r="27" fill="#ffffff" stroke="#e6e3dc" stroke-width="1.5" />
      <g transform="translate(-13,-13) scale(1.1)" stroke="#595959" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <rect x="3" y="8" width="18" height="12" rx="1.5" />
        <path d="M8.5 8 V6.5 C8.5 5.4 9.4 4.5 10.5 4.5 H13.5 C14.6 4.5 15.5 5.4 15.5 6.5 V8" />
        <path d="M3 13.5 H21" />
      </g>
    </g>
  </g>
</svg>

