---
// Original illustration for the Data Security page, built in the same
// style/gradient as the other page illustrations (no stock art). A central shield
// with a lock, orbited by three badges that echo the three things this page
// actually promises: your systems stay yours (server), your people are
// vetted (users), and the process is GDPR-checked (badge-check) — reusing
// Icon.astro's exact line-icon paths so the iconography matches the rest of
// the site instead of introducing a new visual language.
---
<svg
  class="hero-illustration"
  viewBox="0 0 480 420"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  role="img"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="sec-card" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#666666" />
      <stop offset="1" stop-color="#2e2e2e" />
    </linearGradient>
  </defs>

  <!-- soft backdrop shapes -->
  <circle cx="370" cy="330" r="110" fill="#BF9100" opacity="0.07" />
  <circle cx="70" cy="70" r="80" fill="#595959" opacity="0.06" />

  <!-- dashed connector lines from each badge to the shield -->
  <g stroke="#c9c6bd" stroke-width="1.5" stroke-dasharray="4 5">
    <line x1="118" y1="112" x2="205" y2="160" />
    <line x1="368" y1="96" x2="290" y2="150" />
    <line x1="352" y1="300" x2="278" y2="245" />
  </g>

  <!-- central shield -->
  <g transform="translate(60,5) scale(5.3)">
    <path
      d="M34 16 L50 22 V33 C50 43 43.5 51 34 54 C24.5 51 18 43 18 33 V22 Z"
      fill="url(#sec-card)"
    />
  </g>
  <!-- lock icon, centered on the shield (path lifted from Icon.astro's 'lock') -->
  <g transform="translate(178,118) scale(5)" stroke="#ffffff" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" fill="none">
    <rect x="5" y="11" width="14" height="10" rx="1.5" />
    <path d="M8 11 V7.5 C8 5 9.8 3 12 3 C14.2 3 16 5 16 7.5 V11" />
  </g>

  <!-- three orbiting badges, each a static outer <g> (position) wrapping an
       inner <g> (formerly animated; the drift animation was removed) — the
       split matters (CSS transform would otherwise override the SVG one). -->
  <g transform="translate(86,78)">
    <g class="hi-float hi-float--a">
      <circle r="32" fill="#ffffff" stroke="#e6e3dc" stroke-width="1.5" />
      <g transform="translate(-16,-16) scale(1.33)" stroke="#BF9100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <rect x="3" y="4" width="18" height="6.5" rx="1" />
        <rect x="3" y="13.5" width="18" height="6.5" rx="1" />
        <circle cx="7" cy="7.25" r="0.75" fill="#BF9100" stroke="none" />
        <circle cx="7" cy="16.75" r="0.75" fill="#BF9100" stroke="none" />
      </g>
    </g>
  </g>

  <g transform="translate(384,72)">
    <g class="hi-float hi-float--b">
      <circle r="30" fill="#ffffff" stroke="#e6e3dc" stroke-width="1.5" />
      <g transform="translate(-15,-15) scale(1.25)" stroke="#595959" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <circle cx="12" cy="12" r="9" />
        <path d="M8 12.3 10.7 15 16 9.3" />
      </g>
    </g>
  </g>

  <g transform="translate(360,312)">
    <g class="hi-float hi-float--c">
      <circle r="30" fill="#ffffff" stroke="#e6e3dc" stroke-width="1.5" />
      <g transform="translate(-15,-15) scale(1.25)" stroke="#BF9100" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" fill="none">
        <circle cx="9" cy="8.5" r="3.25" />
        <path d="M2.75 20 C2.75 15.9 5.5 13 9 13 C12.5 13 15.25 15.9 15.25 20" />
        <circle cx="17.5" cy="8.75" r="2.4" />
        <path d="M15.6 13.3 C18.6 13.6 20.6 15.9 21.1 19" />
      </g>
    </g>
  </g>

  <!-- small accent dots -->
  <circle class="hi-float hi-float--dot" cx="150" cy="330" r="5" fill="#BF9100" opacity="0.5" />
  <circle class="hi-float hi-float--dot" cx="270" cy="60" r="4" fill="#595959" opacity="0.4" />
</svg>

