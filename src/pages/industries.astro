---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

// Each sector is its own file under src/data/industries/ so the site's
// CMS (public/admin/) can add, edit, remove and reorder them without
// touching code. `order` controls display order.
const sectorModules = import.meta.glob('../data/industries/*.json', {
  eager: true,
  import: 'default',
}) as Record<string, { order: number; name: string; note: string }>;
const sectors = Object.values(sectorModules).sort((a, b) => a.order - b.order);
---
<BaseLayout
  title="Industries We Support"
  description="Experience across a genuine range of UK client sectors, built through full-lifecycle work — onboarding, AML/CDD, bookkeeping, statutory accounts and filing — for a leading UK accountancy startup firm."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Industries We Serve</p>
      <h1>Experience Across a Genuine Range of UK Client Types</h1>
      <p class="lead">
        This isn't a generic list. It reflects the actual sector spread of client work we've handled
        end-to-end — onboarding, AML/CDD, bookkeeping, statutory accounts, and filing — for a leading
        UK accountancy startup firm.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Sectors We've Worked Across</h2>
      <div class="grid grid--3" style="margin-top: var(--space-3);">
        {sectors.map((s) => (
          <div class="card">
            <h3>{s.name}</h3>
            <p>{s.note}</p>
          </div>
        ))}
      </div>
      <p class="lead" style="margin-top: var(--space-3);">…and a range of other SME sectors.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand
        headline="Work With Clients in a Different Sector?"
        body="Tell us more about your client base and we'll confirm whether it's a good fit."
      />
    </div>
  </section>
</BaseLayout>
