---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const groups: { label: string; tools: string }[] = [
  { label: 'Bookkeeping', tools: 'Xero, QuickBooks, Odoo, FreeAgent, Dext, Hubdoc, AutoEntry' },
  { label: 'Year-end accounts and tax', tools: 'TaxCalc, IRIS, CCH' },
  { label: 'Practice management', tools: 'BrightManager' },
  { label: 'Company secretarial and compliance', tools: 'Inform Direct, AML screening tools' },
  { label: 'Everyday collaboration', tools: 'Microsoft Outlook, Teams, Excel, Word' },
];
---
<BaseLayout
  title="Xero, QuickBooks & IRIS Outsourcing Partner | SM Global"
  description="Hands-on experience across Xero, QuickBooks, IRIS, CCH and TaxCalc. An outsourced accounting team that fits straight into your practice's existing software."
>
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">Team Specialisation</p>
      <h1>The software our team works in</h1>
      <p class="lead">
        Our team has hands-on experience of the platforms UK practices use, so we can work in your
        existing software from the start.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Tools by area of work</h2>
      <dl class="spec-list">
        {groups.map((g) => (
          <div class="spec-list__row">
            <dt>{g.label}</dt>
            <dd>{g.tools}</dd>
          </div>
        ))}
      </dl>
      <p class="lead" style="margin-top: var(--space-3);">
        We also help design and automate working papers to match your practice's own templates. That
        cuts manual rework and keeps files consistent across your team.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand headline="Want to see how this would work with your systems?" tone="light" />
    </div>
  </section>
</BaseLayout>
