---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
---
<BaseLayout
  title="About SM Global Accounting Services"
  description="Meet the outsourced accounting team supporting UK accountancy practices with statutory accounts, personal tax and bookkeeping — GDPR-compliant, UK GAAP-trained, and built to work as an extension of your firm."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">About Us</p>
      <h1>An Extension of Your Practice, Not a Replacement for It</h1>
      <p class="lead">
        SM Global Accounting Services is an outsourcing partnership built specifically around the needs
        of UK accountancy practices. We handle the statutory accounts, personal tax, bookkeeping and
        compliance workload that takes up your team's time — so your practice can focus on advisory
        work and client relationships, the parts of the job that actually need to happen in-house.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>What We Believe</h2>
      <div class="grid grid--3" style="margin-top: var(--space-3);">
        <div class="card">
          <h3>Your data is not ours to risk</h3>
          <p>Every process is built around keeping client data inside your own systems.</p>
        </div>
        <div class="card">
          <h3>Outsourcing should feel invisible to your clients</h3>
          <p>We work under your brand, your templates, and your quality standards.</p>
        </div>
        <div class="card">
          <h3>Good outsourcing is a relationship, not a transaction</h3>
          <p>Dedicated teams, regular check-ins, and a named point of contact — not a ticket queue.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Trained on the Standards You Work To</h2>
      <p class="lead">
        Our accountants and bookkeepers are trained on UK GAAP — including FRS 102 (Section 1A) and
        FRS 105 for small companies and micro-entities — alongside Making Tax Digital requirements,
        current HMRC filing deadlines, and Companies House statutory obligations. We're not adapting
        a generic process to UK rules; UK compliance is the process.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="placeholder-note">
        This page intentionally leaves out a founding story and named leadership bios — neither has been
        confirmed yet. Add real detail (when and why the firm started, and who leads it) once it's ready;
        see <code>LAUNCH_CHECKLIST.md</code>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand headline="Want to See How We'd Fit Into Your Practice?" />
    </div>
  </section>
</BaseLayout>
