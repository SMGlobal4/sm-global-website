---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
---
<BaseLayout
  title="SM Global Accounting Services | Outsourced Accounting for UK Practices"
  description="Dedicated statutory accounts, personal tax and bookkeeping support for UK accountancy firms — secure, GDPR-compliant outsourcing from a team that works inside your systems, not around them."
>
  <section class="section hero">
    <div class="container hero__inner">
      <div>
        <p class="eyebrow">Outsourced Accounting for UK Practices</p>
        <h1>Your Practice's Outsourced Accounting Team</h1>
        <p class="lead">
          Statutory accounts, personal tax and bookkeeping — handled by a team that works
          inside your own systems, under your brand, with your data never leaving your control.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/contact">Book a Free Consultation</a>
          <a class="btn btn--secondary" href="/how-we-work">See How We Work</a>
        </div>
        <ul class="trust-strip">
          <li>GDPR-compliant, encrypted data handling</li>
          <li>Experience across Xero, QuickBooks, IRIS, CCH &amp; TaxCalc</li>
          <li>Full client lifecycle: onboarding, AML/CDD, bookkeeping to filing</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Why Practices Outsource to Us</p>
      <h2>Capacity Your Practice Can Rely On</h2>
      <div class="grid grid--2" style="margin-top: var(--space-3);">
        <div class="card">
          <h3>Capacity without the hire</h3>
          <p>Scale up during Self Assessment or year-end peaks without recruiting, training, or carrying idle overhead the rest of the year.</p>
        </div>
        <div class="card">
          <h3>Work stays in your systems</h3>
          <p>We log in securely to your existing software — nothing is copied, downloaded, or moved to a third-party platform.</p>
        </div>
        <div class="card">
          <h3>A dedicated team, not a rotating pool</h3>
          <p>The people working on your files get to know your practice, your clients, and your way of doing things.</p>
        </div>
        <div class="card">
          <h3>Built around UK compliance</h3>
          <p>Our processes are built around FRS 102 (Section 1A), FRS 105, Making Tax Digital, and current HMRC and Companies House filing requirements — not adapted from a generic offshore template.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">What We Do</p>
      <h2>Where We Specialise</h2>
      <p class="lead">
        Statutory accounts, personal taxation and bookkeeping are what we're built around —
        alongside the wider compliance workload UK practices hand off to us.
      </p>
      <div class="grid grid--3" style="margin-top: var(--space-3);">
        <div class="card">
          <h3>Year-End Statutory Accounts</h3>
          <p>Prepared under FRS 102 (Section 1A) or FRS 105, ready for your review and Companies House filing.</p>
        </div>
        <div class="card">
          <h3>Self Assessment &amp; Personal Tax</h3>
          <p>Personal tax returns for sole traders, partners and directors, ahead of the Self Assessment deadline.</p>
        </div>
        <div class="card">
          <h3>Bookkeeping &amp; VAT</h3>
          <p>Ongoing transaction processing, bank reconciliation and Making Tax Digital VAT returns.</p>
        </div>
      </div>
      <p style="margin-top: var(--space-3);"><a href="/services">See all services →</a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">Proof, Not Just a Pitch</p>
      <h2>Trusted With the Full Client Lifecycle</h2>
      <p class="lead">
        We already run the complete relationship — from onboarding and AML/CDD through to bookkeeping,
        statutory accounts and filing — for a leading UK accountancy startup firm. That's not a single
        service bolted on; it's end-to-end ownership of client work, under someone else's brand, done properly.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid--2">
        <div class="card">
          <h3>How we work</h3>
          <p>We start with a conversation and agree the way you'd like to work with us — dedicated FTE, pay-as-you-go, or full portfolio management.</p>
          <p><a href="/how-we-work">See our process →</a></p>
        </div>
        <div class="card">
          <h3>Data security</h3>
          <p>Your client data is sensitive — we treat it that way. GDPR-compliant, encrypted, and never stored outside your own systems.</p>
          <p><a href="/data-security">Read about our data security →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand
        headline="Ready to Free Up Your Team's Time?"
        body="Book a free, no-obligation consultation and we'll talk through where extra capacity would help most."
      />
    </div>
  </section>
</BaseLayout>
