---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import IconBadge from '../components/IconBadge.astro';
import TrialOffer from '../components/TrialOffer.astro';
import { SITE } from '../site.config';
---
<BaseLayout
  title="Outsourced Accounting Services for UK Accountancy Practices"
  description="Statutory accounts, bookkeeping and tax support for UK accountancy firms. An outsourced team working securely inside your own systems, not around them."
>
  <section class="section hero hero--home">
    <div class="container hero__inner">
      <div>
        <p class="eyebrow">Outsourced accounting for UK practices</p>
        <h1>Accounts, tax and bookkeeping for UK accountancy practices</h1>
        <p class="lead">
          We prepare your clients' accounts in your own Xero or QuickBooks, under your name, and you
          review before filing. Your client data stays in your systems.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={SITE.bookingUrl}>Book a Free Consultation</a>
          <a class="text-link" href="/how-we-work">See how we work →</a>
        </div>
        <ul class="plain-list">
          <li>GDPR-compliant, encrypted data handling</li>
          <li>Experience across Xero, QuickBooks, IRIS, CCH and TaxCalc</li>
          <li>Full client lifecycle: onboarding, AML/CDD, bookkeeping through to UK statutory filing</li>
        </ul>
      </div>
    </div>
    <div class="hero__photo">
      <img
        src="/images/hero-london-960.webp"
        srcset="/images/hero-london-640.webp 640w, /images/hero-london-960.webp 960w, /images/hero-london-1448.webp 1448w, /images/hero-london-2000.webp 2000w"
        sizes="(max-width: 900px) 100vw, 72vw"
        width="1448"
        height="1086"
        alt="The Houses of Parliament and Big Ben beside the River Thames in London at sunset"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </section>

  <section class="stat-band">
    <div class="container">
      <div class="stat-strip">
        <div class="stat">
          <span class="stat__value">120–130 clients</span>
          <span class="stat__label">supported by our team</span>
        </div>
        <div class="stat">
          <span class="stat__value">UK · US · UAE</span>
          <span class="stat__label">where our clients are based</span>
        </div>
        <div class="stat">
          <span class="stat__value">Since 2025</span>
          <span class="stat__label">trading as SM Global</span>
        </div>
      </div>
      <p class="stat-band__note">
        For our main client practice we handle the whole client lifecycle: onboarding, AML screening,
        bookkeeping, and UK statutory accounts and filing.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="split__head">
        <p class="eyebrow">Why practices outsource to us</p>
        <h2>Four reasons practices hand work to us</h2>
        <p class="lead">
          What changes for your practice when part of the workload is with us.
        </p>
      </div>
      <div class="text-list">
        <div class="text-list__item">
          <h3>More capacity, no new hire</h3>
          <p>We take on the Self Assessment and year-end peaks, so you don't recruit and train for them or pay for idle time the rest of the year.</p>
        </div>
        <div class="text-list__item">
          <h3>Your data stays in your systems</h3>
          <p>We log in securely to your existing software. Nothing is copied, downloaded or moved to a third-party platform. <a href="/data-security">How we protect your data</a>.</p>
        </div>
        <div class="text-list__item">
          <h3>The same team on your files</h3>
          <p>A dedicated team works on your files, not a rotating pool, so they get to know your practice, your clients and the way you work.</p>
        </div>
        <div class="text-list__item">
          <h3>Built around UK rules</h3>
          <p>Our processes follow FRS 102 (Section 1A), FRS 105, Making Tax Digital, and current HMRC and Companies House filing requirements. They are not adapted from a generic offshore template.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <p class="eyebrow">What we do</p>
      <h2>Accounts, personal tax and bookkeeping</h2>
      <p class="lead">
        These three are what we are built around. We also handle the wider compliance work UK
        practices hand off to us.
      </p>
      <div class="grid grid--feature" style="margin-top: var(--space-3);">
        <div class="card card--large">
          <IconBadge name="document" />
          <h3>Year-end statutory accounts</h3>
          <p>Prepared under FRS 102 (Section 1A) or FRS 105, ready for your review and Companies House filing.</p>
        </div>
        <div class="card">
          <IconBadge name="percent" />
          <h3>Self Assessment and personal tax</h3>
          <p>Personal tax returns for sole traders, partners and directors, ahead of the Self Assessment deadline.</p>
        </div>
        <div class="card">
          <IconBadge name="book" />
          <h3>Bookkeeping and VAT</h3>
          <p>Ongoing transaction processing, bank reconciliation and Making Tax Digital VAT returns.</p>
        </div>
      </div>
      <p style="margin-top: var(--space-3);"><a class="text-link" href="/services">See all services →</a></p>
    </div>
  </section>

  <section class="band-dark band-dark--photo">
    <img
      class="band-dark__bg"
      src="/images/london-gold-1448.webp"
      srcset="/images/london-gold-960.webp 960w, /images/london-gold-1448.webp 1448w, /images/london-gold-2000.webp 2000w"
      sizes="100vw"
      width="1448"
      height="1086"
      alt=""
      loading="lazy"
      decoding="async"
    />
    <div class="container band-dark__inner">
      <div>
        <p class="band-dark__eyebrow">Our track record</p>
        <h2>We built one UK practice's back office from scratch, and we still run it.</h2>
      </div>
      <div class="band-dark__body">
        <div>
          <h3>Where it started</h3>
          <p>A newly incorporated UK accountancy practice had no back office: no processes, no software, nothing built.</p>
        </div>
        <div>
          <h3>What we did</h3>
          <p>We built it and then ran it: company secretarial and admin work, tax and bookkeeping software setup, AML screening, client onboarding, bookkeeping, and UK statutory accounts and filing.</p>
        </div>
        <div>
          <h3>Where it is now</h3>
          <p>That relationship is still the core of our work. We have full ownership of client work under their own brand, across around 120–130 clients, with bookkeeping support across the UK, US, UAE and beyond.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">How we work</p>
      <h2>How an engagement starts</h2>
      <ol class="numbered-steps">
        <li>
          <h3>A conversation</h3>
          <p>We start with a free consultation about your workload and where extra capacity would help most.</p>
        </li>
        <li>
          <h3>A look at how you work</h3>
          <p>We review your workflow, templates and tools. If your current way is already the most efficient, we keep it as it is. If we see a better way, we say so, and you decide.</p>
        </li>
        <li>
          <h3>You choose how we work together</h3>
          <p>A dedicated full-time team member, pay as you go, or full portfolio management. You can mix them as your needs change.</p>
        </li>
      </ol>
      <p style="margin-top: var(--space-3);"><a class="text-link" href="/how-we-work">Read more about how we work →</a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <TrialOffer />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand
        headline="Tell us where your team is stretched"
        body="Book a free, no-obligation consultation and we'll talk through where extra capacity would help most."
        tone="light"
      />
    </div>
  </section>
</BaseLayout>
