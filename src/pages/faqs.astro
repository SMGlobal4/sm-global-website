---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import faqData from '../data/faqs.json';

// Grouped for scannability now that the list has grown past a dozen
// questions — categories borrowed from how larger outsourcing-firm sites
// (e.g. QX Accounting Services) structure their FAQs: control/process,
// data & security, and pricing/team, rather than one long flat list.
// Content lives in src/data/faqs.json so the site's CMS (public/admin/)
// can edit questions, answers and categories without touching code.
const faqCategories = faqData.categories;
---
<BaseLayout
  title="FAQs | Outsourced Accounting for UK Practices"
  description="Answers to the questions UK practices most often ask before outsourcing: data security, engagement models, pricing and how the process works."
>
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">FAQs</p>
      <h1>Frequently asked questions</h1>
      <p class="lead">
        The questions UK practices most commonly ask before engaging an outsourcing provider.
      </p>
    </div>
  </section>

  {faqCategories.map((group, i) => (
    <section class={`section ${i % 2 === 0 ? 'section--alt' : ''}`}>
      <div class="container">
        <h2>{group.category}</h2>
        <div style="margin-top: var(--space-2);">
          {group.items.map((item, j) => (
            <details class="faq-item" open={i === 0 && j === 0}>
              <summary><h3>{item.q}</h3></summary>
              <p class="faq-item__answer">{item.a}</p>
              {
                /* item.placeholder (see faqs.json: pricing structure, team
                   start time) flags a reasonable-default answer that's worth
                   double-checking against real figures as the business
                   settles into them — tracked in LAUNCH_CHECKLIST.md. Both
                   answers are already hedged ("we'll give you an exact figure
                   once we understand your workload", "typically... can take a
                   little longer") rather than a hard promise, so there's
                   nothing to actively correct — this used to also render a
                   visible "placeholder answer" note here, which read as an
                   admission of incompleteness to real visitors on the exact
                   page (pricing, turnaround) where a prospective client is
                   deciding whether to trust the business. Kept as an internal
                   flag only now, not a public one. */
              }
            </details>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container">
      <CtaBand headline="Still Have a Question?" tone="light" />
    </div>
  </section>
</BaseLayout>
