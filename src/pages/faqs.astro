---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

const faqs = [
  {
    q: 'How is my data kept secure?',
    a: "Your data never leaves your own systems — our team logs in remotely through encrypted, secure connections and works directly inside your existing software. See our Data Security page for the full picture.",
  },
  {
    q: "What's the difference between your three work modules?",
    a: 'FTE gives you a dedicated team member working exclusively on your practice; Pay As You Go is flexible, task-based support with no minimum commitment; Portfolio Management hands over full ownership of a client portfolio end-to-end.',
  },
  {
    q: 'What if I only have occasional overflow work?',
    a: 'Our Pay As You Go module is built for exactly that — you only pay for the work you send us, with no minimum commitment and no fixed monthly cost.',
  },
  {
    q: 'How is pricing structured?',
    a: "Pricing depends on the module: FTE is a fixed monthly rate per dedicated team member, Pay As You Go is priced per task or per hour, and Portfolio Management is scoped to the size and complexity of the portfolio handed over. We'll give you an exact figure once we understand your workload — book a free consultation for a personalised quote.",
    placeholder: true,
  },
  {
    q: 'What does onboarding look like?',
    a: "Once you've chosen a module, we agree access to your systems and priorities with your Engagement Lead, then begin work under your supervision while the team gets up to speed on your specific processes.",
  },
  {
    q: 'How quickly can a new team member start?',
    a: 'Once the engagement model is agreed and access is set up, we can typically have someone working on straightforward bookkeeping within a couple of weeks — more complex handovers, or work needing deeper training on your specific processes, can take a little longer.',
    placeholder: true,
  },
  {
    q: 'What software do you work in?',
    a: 'Xero, QuickBooks, Odoo, FreeAgent, Dext, Hubdoc, AutoEntry, TaxCalc, IRIS, CCH, and BrightManager, among others.',
  },
  {
    q: 'Do you work directly with our clients, or only with us?',
    a: "We work entirely behind the scenes, under your practice's own brand — we don't contact your end clients directly unless you specifically ask us to for a particular piece of work.",
  },
  {
    q: "What happens if we're not happy with a piece of work?",
    a: "Every file already goes through an independent Quality Review check before it reaches you. If something still isn't right, tell your Engagement Lead and we'll correct it at no extra cost, reviewed again before it comes back to you.",
  },
  {
    q: 'Are you GDPR compliant?',
    a: 'Yes — our processes are built around full GDPR compliance, covering how data is accessed, transferred, retained, and deleted.',
  },
];
---
<BaseLayout
  title="Frequently Asked Questions"
  description="Answers to common questions about outsourcing your accounting work to SM Global Accounting Services — data security, engagement models, pricing, and how the process works."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">FAQs</p>
      <h1>Frequently Asked Questions</h1>
      <p class="lead">
        The questions UK practices most commonly ask before engaging an outsourcing provider.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      {faqs.map((item) => (
        <div class="faq-item">
          <h3>{item.q}</h3>
          <p>{item.a}</p>
          {item.placeholder && (
            <p class="placeholder-note" style="margin-top: 0.5rem;">
              Reasonable placeholder answer — confirm the real figure/turnaround and update.
            </p>
          )}
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand headline="Still Have a Question?" />
    </div>
  </section>
</BaseLayout>
