---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import faqData from '../data/faqs.json';

// Grouped for scannability now that the list has grown past a dozen
// questions — categories borrowed from how larger outsourcing-firm sites
// (e.g. QX Accounting Services) structure their FAQs: control/process,
// data & security, and pricing/team, rather than one long flat list.
// Content lives in src/data/faqs.json so the site's CMS (public/admin/)
// can edit questions, answers and categories without touching code.
const faqCategories = faqData.categories;
---
<BaseLayout
  title="Frequently Asked Questions"
  description="Answers to common questions about outsourcing your accounting work to SM Global Accounting Services — data security, engagement models, pricing, and how the process works."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">FAQs</p>
      <h1>Frequently Asked Questions</h1>
      <p class="lead">
        The questions UK practices most commonly ask before engaging an outsourcing provider.
      </p>
    </div>
  </section>

  {faqCategories.map((group, i) => (
    <section class={`section ${i % 2 === 0 ? 'section--alt' : ''}`}>
      <div class="container">
        <h2>{group.category}</h2>
        <div style="margin-top: var(--space-2);">
          {group.items.map((item) => (
            <div class="faq-item">
              <h3>{item.q}</h3>
              <p>{item.a}</p>
              {item.placeholder && (
                <p class="placeholder-note" style="margin-top: 0.5rem;">
                  Reasonable placeholder answer — confirm the real figure/turnaround and update.
                </p>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  ))}

  <section class="section">
    <div class="container">
      <CtaBand headline="Still Have a Question?" />
    </div>
  </section>
</BaseLayout>
