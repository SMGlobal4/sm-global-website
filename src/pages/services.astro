---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import IconBadge from '../components/IconBadge.astro';

// Each service is its own file under src/data/services/ — see that folder's
// README — so the site's CMS (public/admin/) can add, edit, remove and
// reorder them without touching code. `order` controls display order.
const serviceModules = import.meta.glob('../data/services/*.json', {
  eager: true,
  import: 'default',
}) as Record<string, { order: number; icon: string; title: string; body: string }>;
const services = Object.values(serviceModules).sort((a, b) => a.order - b.order);
---
<BaseLayout
  title="Outsourced Accounting Services for UK Practices"
  description="Statutory accounts, personal tax, bookkeeping, VAT, payroll and practice management support — outsourced accounting services built for UK accountancy firms."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Services We Offer</p>
      <h1>The Work Your Team Doesn't Have Time For</h1>
      <p class="lead">
        From statutory accounts and personal tax through to day-to-day bookkeeping, we cover the
        full compliance workload UK practices handle for their clients — so your in-house team can
        focus on advisory and client relationships.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>Our Core Services</h2>
      <div class="grid grid--2" style="margin-top: var(--space-3);">
        {services.map((s) => (
          <div class="card">
            <IconBadge name={s.icon} />
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand
        headline="Not Sure Which Services You Need?"
        body="Tell us where the pressure points are in your practice and we'll recommend where outsourcing would help most."
      />
    </div>
  </section>
</BaseLayout>
