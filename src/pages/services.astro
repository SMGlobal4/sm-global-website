---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';

// Ordered to match the decided positioning wedge: statutory accounts,
// personal taxation and bookkeeping lead; the remaining compliance
// workload follows.
const services = [
  {
    title: 'Year-End Statutory Accounts',
    body: "Preparation of statutory accounts under FRS 102 (Section 1A) or FRS 105, ready for your review and filing with Companies House. Working papers built to your practice's own templates.",
  },
  {
    title: 'Self Assessment & Personal Tax',
    body: 'Personal tax return preparation for sole traders, partners, and directors — including income from property, dividends, and capital gains — ahead of the Self Assessment deadline.',
  },
  {
    title: 'Bookkeeping & VAT Returns',
    body: "Ongoing transaction processing, bank reconciliation, and quarterly VAT return preparation — including Making Tax Digital for VAT compliance. Worked directly in your clients' own Xero, QuickBooks, or FreeAgent files.",
  },
  {
    title: 'Corporation Tax',
    body: 'Corporation tax computations and CT600 preparation, reconciled against the statutory accounts, ready for your final review before submission to HMRC.',
  },
  {
    title: 'Payroll Processing',
    body: 'Weekly, fortnightly, or monthly payroll runs, including RTI submissions, pension auto-enrolment administration, and payslip preparation.',
  },
  {
    title: 'Accounts Payable / Accounts Receivable',
    body: "Purchase ledger and sales ledger management, supplier payment runs, and credit control support for your clients' day-to-day finance operations.",
  },
  {
    title: 'Practice Management Support',
    body: 'Administrative and workflow support inside your practice management software — job tracking, deadline monitoring, and client record maintenance.',
  },
  {
    title: 'Company Secretarial & Compliance',
    body: 'Confirmation statements, company incorporations, and registered office administration, alongside AML (Anti-Money Laundering) screening support for client onboarding.',
  },
];
---
<BaseLayout
  title="Outsourced Accounting Services for UK Practices"
  description="Statutory accounts, personal tax, bookkeeping, VAT, payroll and practice management support — outsourced accounting services built for UK accountancy firms."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Services We Offer</p>
      <h1>The Work Your Team Doesn't Have Time For</h1>
      <p class="lead">
        From statutory accounts and personal tax through to day-to-day bookkeeping, we cover the
        full compliance workload UK practices handle for their clients — so your in-house team can
        focus on advisory and client relationships.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="grid grid--2">
        {services.map((s) => (
          <div class="card">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand
        headline="Not Sure Which Services You Need?"
        body="Tell us where the pressure points are in your practice and we'll recommend where outsourcing would help most."
      />
    </div>
  </section>
</BaseLayout>
