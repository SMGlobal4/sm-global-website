---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import TrialOffer from '../components/TrialOffer.astro';

// Each service is its own file under src/data/ so the site's CMS (public/admin/) can add,
// edit, remove and reorder them without touching code. `order` controls display order.
// (The `icon` field in the JSON is no longer shown on this page; it is kept so the CMS
// entries stay valid.)
const serviceModules = import.meta.glob('../data/services/*.json', {
  eager: true,
  import: 'default',
}) as Record<string, { order: number; icon?: string; title: string; body: string }>;
const services = Object.values(serviceModules).sort((a, b) => a.order - b.order);
---
<BaseLayout
  title="Outsourced Bookkeeping, VAT & Statutory Accounts Services"
  description="Bookkeeping, VAT returns, statutory accounts, payroll and company secretarial support, built specifically for UK accountancy practices."
  image="/images/og-offer.png"
  imageAlt="Your first client file is free: bookkeeping, VAT or statutory accounts for one of your clients, done free"
>
  <section class="section hero">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h1>The compliance work we take on for UK practices</h1>
      <p class="lead">
        We prepare statutory accounts and personal tax returns, and we do the day-to-day bookkeeping.
        That leaves your own team free for advisory work and client relationships.
      </p>
      <p class="lead" style="margin-top: var(--space-2);">
        Statutory accounts preparation and filing is UK company work. Bookkeeping and VAT support
        extends to clients across the UK, US, UAE and beyond.
      </p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <h2>What we do</h2>
      <dl class="spec-list">
        {services.map((s) => (
          <div class="spec-list__row">
            <dt>{s.title}</dt>
            <dd>{s.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <TrialOffer compact />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <CtaBand
        headline="Not sure which services you need?"
        body="Tell us where your practice is under pressure and we'll say where outsourcing would help."
      />
    </div>
  </section>
</BaseLayout>
